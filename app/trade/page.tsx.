              <span>19:00</span>
              <span>20:00</span>
              <span>21:00</span>
              <span>22:00</span>
            </div>
          </section>

          {/* ORDER BOOK */}
          <section className="panel orderbook">
            <div className="panel-title">Order Book</div>

            <div className="book-header">
              <span>Price (USDT)</span>
              <span style={{ textAlign: "right" }}>
                Amount ({coin.symbol})
              </span>
            </div>

            {asks.map(([priceValue, amountValue]) => (
              <div className="book-row" key={priceValue}>
                <span className="ask">{priceValue}</span>
                <span>{amountValue}</span>
              </div>
            ))}

            <div className="spread">
              <span>Spread</span>
              <strong>$12.10</strong>
            </div>

            {bids.map(([priceValue, amountValue]) => (
              <div className="book-row" key={priceValue}>
                <span className="bid">{priceValue}</span>
                <span>{amountValue}</span>
              </div>
            ))}
          </section>

          {/* ORDER FORM */}
          <section className="panel order-panel">
            <div className="order-tabs">
              <button
                className={
                  side === "buy"
                    ? "order-tab buy-active"
                    : "order-tab"
                }
                onClick={() => {
                  setSide("buy");
                  setPercentage(0);
                }}
              >
                Buy
              </button>

              <button
                className={
                  side === "sell"
                    ? "order-tab sell-active"
                    : "order-tab"
                }
                onClick={() => {
                  setSide("sell");
                  setPercentage(0);
                }}
              >
                Sell
              </button>
            </div>

            <div className="order-content">
              <div className="type-tabs">
                <button
                  className={
                    orderType === "limit"
                      ? "type-tab active"
                      : "type-tab"
                  }
                  onClick={() => setOrderType("limit")}
                >
                  Limit
                </button>

                <button
                  className={
                    orderType === "market"
                      ? "type-tab active"
                      : "type-tab"
                  }
                  onClick={() => setOrderType("market")}
                >
                  Market
                </button>
              </div>

              {orderType === "limit" && (
                <>
                  <div className="field-label">Price</div>

                  <div className="input-wrap">
                    <input
                      type="number"
                      value={price}
                      onChange={(e) => setPrice(e.target.value)}
                    />

                    <span className="input-unit">USDT</span>
                  </div>
                </>
              )}

              <div className="field-label">Amount</div>

              <div className="input-wrap">
                <input
                  type="number"
                  placeholder="0.00"
                  value={amount}
                  onChange={(e) => {
                    setAmount(e.target.value);
                    setPercentage(0);
                  }}
                />

                <span className="input-unit">
                  {coin.symbol}
                </span>
              </div>

              <div className="percent-row">
                {[25, 50, 75, 100].map((value) => (
                  <button
                    key={value}
                    className={
                      percentage === value
                        ? "percent-btn active"
                        : "percent-btn"
                    }
                    onClick={() => setPercent(value)}
                  >
                    {value}%
                  </button>
                ))}
              </div>

              <div className="field-label">Total</div>

              <div className="input-wrap">
                <input
                  readOnly
                  value={
                    total
                      ? total.toLocaleString("en-US", {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2,
                        })
                      : ""
                  }
                  placeholder="0.00"
                />

                <span className="input-unit">USDT</span>
              </div>

              <div className="total-row">
                <span>Available</span>

                <strong>
                  {side === "buy"
                    ? "12,540.00 USDT"
                    : `0.084000 ${coin.symbol}`}
                </strong>
              </div>

              <button
                className={
                  side === "buy"
                    ? "submit-btn submit-buy"
                    : "submit-btn submit-sell"
                }
                onClick={submitOrder}
              >
                {side === "buy"
                  ? `Buy ${coin.symbol}`
                  : `Sell ${coin.symbol}`}
              </button>

              {message && (
                <div className="message">{message}</div>
              )}

              <div className="balance">
                <span>Trading fee</span>
                <strong>0.10%</strong>
              </div>
            </div>
          </section>
        </div>

        {/* BOTTOM */}
        <div className="bottom-grid">
          <section className="panel bottom-panel">
            <div className="panel-title">Open Orders</div>

            <div className="empty-state">
              No open orders
            </div>
          </section>

          <section className="panel bottom-panel">
            <div className="panel-title">Recent Trades</div>

            <table className="trades-table">
              <thead>
                <tr>
                  <th>Price</th>
                  <th>Amount</th>
                  <th>Time</th>
                </tr>
              </thead>

              <tbody>
                {recentTrades.map(
                  ([tradePrice, tradeAmount, time]) => (
                    <tr key={`${tradePrice}-${time}`}>
                      <td
                        className={
                          Number(tradePrice) >
                          coin.price
                            ? "positive"
                            : "negative"
                        }
                      >
                        {tradePrice}
                      </td>

                      <td>{tradeAmount}</td>

                      <td>{time}</td>
                    </tr>
                  )
                )}
              </tbody>
            </table>
          </section>
        </div>
      </section>

      {/* BOTTOM NAVIGATION */}
      <nav className="bottom-nav">
        <div className="nav-inner">
          <button
            className="nav-item"
            onClick={() => router.push("/exchange")}
          >
            <span className="nav-icon">⌂</span>
            Home
          </button>

          <button
            className="nav-item"
            onClick={() => router.push("/exchange")}
          >
            <span className="nav-icon">◈</span>
            Markets
          </button>

          <button className="nav-item active">
            <span className="nav-icon">⇄</span>
            Trade
          </button>

          <button
            className="nav-item"
            onClick={() => router.push("/futures")}
          >
            <span className="nav-icon">◒</span>
            Futures
          </button>

          <button
            className="nav-item"
            onClick={() => router.push("/assets")}
          >
            <span className="nav-icon">▣</span>
            Assets
          </button>
        </div>
      </nav>
    </main>
  );
}
